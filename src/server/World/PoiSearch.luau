--!strict
--[[
	/locate poi: the nearest point of interest (Shared/Poi: chests, furnaces, machines...) to a
	player, Minecraft 1.20.1's PoiManager.findClosestWithType(pred, pos, 256, ANY) on this engine,
	where nothing keeps a list of them. Pure Luau over a World/WorldServer world and a generator,
	so the specs run it under Lune and the server runs it in a budgeted coroutine
	(Players/LocateCommands).

	  Edits      every chunk within radius // 16 + 1 chunks (33 x 33 for 256) whose edits
	             (WorldServer `edits`: what players and block updates put there, each the block
	             there now) hold a wanted block within `radius` (3D, between block positions, as
	             Minecraft's distSqr).
	  Generated  what the generator's plans put there (TerrainGenerator `poiBlocks`: library
	             structures' templates, mineshafts' chests, the debug worlds' laid out blocks), in
	             the radius's square, without generating a chunk; a cell with an edit is left to the
	             edits. With `generatedNear` (Config.Locate.PoiGeneratedNear) only those in chunks
	             the server has loaded count, as Minecraft knows only generated chunks' points.
	  Nearest    the candidates by distance (ties: lowest x, y, z), each generated one checked
	             against the block really there (a later piece or a mineshaft may have replaced it):
	             the world's loaded chunk, else the chunk generated by `generator` a slice at a time
	             (never the world's own: its generator belongs to the chunks being generated in the
	             same frames). The first that holds a wanted block answers.

	Costs: 1,089 edit lists looked up (most chunks have none) at about 0.2 µs an edit, `yield`
	every 2,000; the plans of a 512 x 512 square (1-4 structure starts, 4-9 mineshafts at
	1-5 ms each, sliced by their own yields); one chunk generated per candidate checked outside
	the loaded ones (1-3 ms, sliced). Some 10-60 ms in all.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("IceVoxel")
local ChunkLayout = require(Shared.World.ChunkLayout)
local Coords = require(Shared.World.Coords)
local Poi = require(Shared.Poi)
local TerrainGenerator = require(Shared.Generation.TerrainGenerator)

local WorldServer = require(script.Parent.WorldServer)

type World = WorldServer.World

local SIZE = ChunkLayout.SIZE
local P = ChunkLayout.PADDED
local readu8 = buffer.readu8
local readu16 = buffer.readu16

-- Edits looked at between two yields.
local EDITS_PER_YIELD = 2000

export type Options = {
	-- Called often; may suspend the search (the caller's budget).
	yield: (() -> ())?,
	-- Only generated points in chunks the world has loaded.
	generatedNear: boolean?,
	-- Counts: `probes` candidates found, `verified` generated ones checked.
	stats: { probes: number, verified: number }?,
}

-- What was found: its type id, block position and 3D distance (blocks).
export type Found = { id: string, x: number, y: number, z: number, distance: number }

type Candidate = { d: number, x: number, y: number, z: number, block: number, generated: boolean }

local PoiSearch = {}

local function noYield() end

local function before(a: Candidate, b: Candidate): boolean
	if a.d ~= b.d then
		return a.d < b.d
	elseif a.x ~= b.x then
		return a.x < b.x
	elseif a.y ~= b.y then
		return a.y < b.y
	end
	return a.z < b.z
end

--[[
	The nearest block of a type in `wanted` (Poi type indices) within `radius` blocks (3D) of
	block (px, py, pz), nil when none (see the header). `generator` makes the generated
	candidates and checks them (default: the world's own, for tests).
]]
function PoiSearch.nearest(
	world: World,
	generator: TerrainGenerator.Generator?,
	wanted: { [number]: boolean },
	px: number,
	py: number,
	pz: number,
	radius: number,
	options: Options?
): Found?
	local opts: Options = options or {}
	local pause = opts.yield or noYield
	local stats = opts.stats or { probes = 0, verified = 0 }
	local gen = generator or world.generator
	local lut = Poi.lut
	local bx, by, bz = math.floor(px), math.floor(py), math.floor(pz)
	local r2 = radius * radius
	local candidates: { Candidate } = {}

	-- Players' and block updates' edits: the blocks there now.
	local pcx, pcz = bx // SIZE, bz // SIZE
	local reach = radius // SIZE + 1
	local seen = 0
	for cz = pcz - reach, pcz + reach do
		for cx = pcx - reach, pcx + reach do
			local edits = world.edits[Coords.chunkKey(cx, cz)]
			if edits == nil then
				continue
			end
			for index, block in edits do
				seen += 1
				if seen % EDITS_PER_YIELD == 0 then
					pause()
				end
				local t = readu8(lut, block)
				if t == 0 or not wanted[t] then
					continue
				end
				local lx, y, lz = ChunkLayout.fromLocalIndex(index)
				local x, z = cx * SIZE + lx, cz * SIZE + lz
				local d2 = (x - bx) ^ 2 + (y - by) ^ 2 + (z - bz) ^ 2
				if d2 <= r2 then
					table.insert(candidates, { d = d2, x = x, y = y, z = z, block = block, generated = false })
				end
			end
		end
	end
	pause()

	-- What the plans put there, where no edit changed it.
	local poiBlocks = gen.poiBlocks
	if poiBlocks then
		local list = poiBlocks(bx - radius, bz - radius, bx + radius, bz + radius, lut, pause)
		for i = 1, #list, 4 do
			local x, y, z, block = list[i], list[i + 1], list[i + 2], list[i + 3]
			local t = readu8(lut, block)
			if t == 0 or not wanted[t] then
				continue
			end
			local d2 = (x - bx) ^ 2 + (y - by) ^ 2 + (z - bz) ^ 2
			if d2 > r2 then
				continue
			end
			local cx, cz = x // SIZE, z // SIZE
			local edits = world.edits[Coords.chunkKey(cx, cz)]
			if edits and edits[ChunkLayout.localIndex(x - cx * SIZE, y, z - cz * SIZE)] ~= nil then
				continue
			end
			if opts.generatedNear and world:peekChunk(cx, cz) == nil then
				continue
			end
			table.insert(candidates, { d = d2, x = x, y = y, z = z, block = block, generated = true })
		end
		pause()
	end
	stats.probes += #candidates
	if #candidates == 0 then
		return nil
	end
	table.sort(candidates, before)

	-- Chunks generated to check candidates, by chunk key.
	local generated: { [number]: TerrainGenerator.ChunkResult } = {}
	for _, c in candidates do
		local block = c.block
		if c.generated then
			stats.verified += 1
			local loaded = world:peekBlock(c.x, c.y, c.z)
			if loaded then
				block = loaded
			else
				local cx, cz = c.x // SIZE, c.z // SIZE
				local key = Coords.chunkKey(cx, cz)
				local chunk = generated[key]
				if chunk == nil then
					local made = gen.generate(0, cx, cz, pause)
					generated[key] = made
					chunk = made
				end
				assert(chunk)
				if c.y < 0 or c.y >= chunk.height then
					continue
				end
				block = readu16(chunk.data, ((c.y * P + c.z - cz * SIZE + 1) * P + c.x - cx * SIZE + 1) * 2)
			end
			pause()
		end
		local t = readu8(lut, block)
		if t ~= 0 and wanted[t] then
			return { id = Poi.types[t].id, x = c.x, y = c.y, z = c.z, distance = math.sqrt(c.d) }
		end
	end
	return nil
end

-- The type indices of type ids (unknown ones left out).
function PoiSearch.wanted(ids: { string }): { [number]: boolean }
	local set: { [number]: boolean } = {}
	for _, id in ids do
		local poiType = Poi.get(id)
		if poiType then
			set[poiType.index] = true
		end
	end
	return set
end

return PoiSearch
